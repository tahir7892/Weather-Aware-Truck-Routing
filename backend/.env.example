# Copy this file to .env and fill in the values.

# OpenRouteService (geocoding + truck routing) - https://openrouteservice.org/
ORS_API_KEY=your_openrouteservice_key_here

# Open-Meteo (weather, no key needed)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Django
DJANGO_SECRET_KEY=change_me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin allowed to call the API (Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Optional (defaults shown) ---
# EXTERNAL_API_TIMEOUT=15
# CACHE_DIR=.cache
# THROTTLE_PLAN_TRIP=20/min
# THROTTLE_HEATMAP=30/min
# THROTTLE_GEOCODE=90/min
# LOG_LEVEL=INFO

# --- Production only ---
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=your-backend.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# NUM_PROXIES=1
# CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com
# SECURE_SSL_REDIRECT=False
